# NextAuthJS
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-unique-value-with-openssl-rand-base64-32

# GitHub OAuth app (required for GitHub login)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Optional OAuth providers
BITBUCKET_CLIENT_ID=your-bitbucket-oauth-client-id
BITBUCKET_CLIENT_SECRET=your-bitbucket-oauth-client-secret
BITBUCKET_OAUTH_CLIENT_ID=your-bitbucket-oauth-consumer-id
GITLAB_CLIENT_ID=your-gitlab-oauth-client-id
GITLAB_CLIENT_SECRET=your-gitlab-oauth-client-secret

# Development PostgreSQL/Supabase database
PGSQL_USER=your-database-user
PGSQL_PASSWORD=your-database-password
PGSQL_HOST=your-database-host
PGSQL_PORT=6543
PGSQL_DATABASE=postgres
